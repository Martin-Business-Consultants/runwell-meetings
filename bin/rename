#!/usr/bin/env ruby
# Make the template your plugin: bin/rename "Plant care"
# Renames the key (plant_care: gemspec, tables, registrations), the module (PlantCare), the CSS
# and URL slug (plant-care), the display name, and the files and folders that carry them.
require "fileutils"

name = ARGV.join(" ").strip
abort %(Usage: bin/rename "Plant care") if name.empty?

key = name.downcase.gsub(/[^a-z0-9]+/, "_").gsub(/\A_|_\z/, "")
abort "The name needs a letter or digit." if key.empty?
mod = key.split("_").map(&:capitalize).join
slug = key.tr("_", "-")

replacements = { "MyPlugin" => mod, "my_plugin" => key, "my-plugin" => slug, "My plugin" => name }

files = Dir.glob("**/*", File::FNM_DOTMATCH).select { File.file?(it) }.reject { it.start_with?(".git/") || it == "bin/rename" }
files.each do |path|
  text = File.read(path)
  updated = replacements.reduce(text) { |memo, (from, to)| memo.gsub(from, to) }
  File.write(path, updated) unless updated == text
end

Dir.glob("**/*my_plugin*").sort_by { -it.count("/") }.each do |path|
  FileUtils.mv(path, File.join(File.dirname(path), File.basename(path).gsub("my_plugin", key)))
end

puts "Now #{name} (#{key}). Next: set author and homepage in #{key}.gemspec and lib/#{key}/engine.rb, then"
puts %(  bin/rails "plugins:link[#{Dir.pwd}]" from your Runwell checkout.)
