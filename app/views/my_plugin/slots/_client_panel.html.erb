<%# locals: (client:) %>
<%# A tab on each client page (the :client_panel slot). Its first heading is hidden: the tab names it. %>
<section class="settings__section flex flex-column gap-half">
  <h2 class="divider">Pinned</h2>
  <% items = client.my_plugin_items.ordered.includes(:user) %>
  <% if items.any? %>
    <ul class="my-plugin-items">
      <% items.each do |item| %>
        <%# herb:key item.id %>
        <li class="my-plugin-item">
          <%= person_tag item.user %>
          <span class="my-plugin-item__body"><%= item.body %></span>
          <% if item.removable_by?(Current.user) %>
            <%= render "layouts/shared/delete_dialog", name: "this pinned item", path: my_plugin_item_path(item), trigger_class: "txt-small" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="txt-small txt-subtle margin-none">Nothing pinned yet.</p>
  <% end %>
  <%= form_with url: my_plugin_items_path, scope: :item, class: "flex gap-half txt-small", namespace: dom_id(client, :pin) do |form| %>
    <%= form.hidden_field :client_id, value: client.id %>
    <%= form.text_field :body, class: "input", placeholder: "Pin a line to #{client.name}", required: true, maxlength: 200, autocomplete: "off" %>
    <button type="submit" class="btn txt-small">Pin</button>
  <% end %>
</section>
